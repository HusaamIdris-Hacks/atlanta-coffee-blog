# Foursquare Places API key (get one at https://foursquare.com/developers/signup)
# Required for Phase 1b: fetches Atlanta coffee shops on backend startup
FOURSQUARE_API_KEY=your_foursquare_api_key_here
FOURSQUARE_API_SECRET=your_key_here
JWT_SECRET=your_random_secret_key_here

# Optional: override database URL (default: sqlite+aiosqlite:///./data/atlanta_coffee.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/atlanta_coffee.db

# Optional: set to "true" to log SQL queries
# SQL_ECHO=false

# ── Password Reset (Email) ────────────────────────────────────────────────────
# Leave SMTP_HOST blank in development — the reset link is printed to the
# backend console instead of sent via email (no mail server needed).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@beancompassatl.com
# SMTP_TLS=true          # set to "false" for plain SMTP (port 25)
# APP_BASE_URL=http://localhost:3000   # used to build the reset link URL
